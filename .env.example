# Copy to .env and fill in. .env is gitignored.

# OpenObserve root credentials (password needs upper, lower, digit, special char)
ZO_ROOT_USER_EMAIL=you@example.com
ZO_ROOT_USER_PASSWORD=ChangeMe@123

# base64 of "ZO_ROOT_USER_EMAIL:ZO_ROOT_USER_PASSWORD"
#   echo -n 'you@example.com:ChangeMe@123' | base64
OPENOBSERVE_BASIC_TOKEN=

# LiteLLM master key — generate with: echo "sk-$(openssl rand -hex 32)"
LITELLM_MASTER_KEY=
